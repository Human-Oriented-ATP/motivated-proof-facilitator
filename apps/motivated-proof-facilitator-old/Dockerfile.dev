FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy remaining files (will be overridden by volumes in dev)
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start dev server (can be overridden in compose.dev.yml)
CMD ["npm", "run", "dev", "--", "--host"]
