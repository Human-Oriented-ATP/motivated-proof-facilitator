{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/index.ts", "src/endpoints/**/*.ts", "vite.config.ts"]
}
